<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "app" (slug: app): the Xivly program itself,
  signed before the installers are built so both of them ship a signed xivly.exe.
  The GitHub artifact is a zip holding exactly one file: xivly.exe.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="xivly.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
