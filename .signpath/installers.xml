<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "installers" (slug: installers), stable releases:
  the NSIS setup and the MSI. Both are built around xivly.exe, already signed by the
  "app" configuration, so only the installers themselves are signed here.
  The GitHub artifact is a zip holding nsis/ and msi/ (upload-artifact keeps the folders below their common parent).
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="nsis/Xivly_*_x64-setup.exe">
      <authenticode-sign/>
    </pe-file>
    <msi-file path="msi/Xivly_*_x64_en-US.msi">
      <authenticode-sign/>
    </msi-file>
  </zip-file>
</artifact-configuration>
